[lfs]
	url = https://gitlab.com/commaai/openpilot-lfs.git/info/lfs
	pushurl = ssh://git@gitlab.com/commaai/openpilot-lfs.git
	locksverify = false
	# ============================================================================================
	# EXCLUDED BY DEFAULT — AND IT MUST STAY THAT WAY. Do not "fix" this by removing the exclude.
	# ============================================================================================
	# lebowski2pnw (2026-07-09): big_driving_supercombo.onnx is 1.7 GB and is ONLY ever read on an
	# external-GPU (eGPU-via-tinygrad) host — modeld builds the big pkl solely when UsbGpuPresent.
	# The comma 3X never touches its content, so fetching it would add ~95% to every install and
	# update download for zero benefit on the car.
	#
	# Consequence you WILL hit if you touch this: `git lfs pull` deliberately leaves the file as a
	# ~135 B LFS POINTER. release/build_stripped.sh then runs `git lfs ls-files` and aborts the
	# release with "LFS files detected!" — this broke the 3pnw aarch64 build on 2026-07-20. It is
	# therefore ALSO excluded from the release file set in release/release_files.py; the two
	# exclusions belong together, so if you ever change one, change the other.
	#
	# Planned: an eGPU toggle will make this opt-in for the (rare) tinygrad-on-external-GPU setup.
	# Until then, anyone who genuinely needs it fetches it by hand:
	#   git lfs pull --include big_driving_supercombo.onnx
	fetchexclude = *big_driving_supercombo.onnx
